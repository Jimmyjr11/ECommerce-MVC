@model IEnumerable<CategoryVM>

@{
    ViewData["Title"] = "Category Management";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h1 class="display-6 fw-bold" style="color: var(--salem-charcoal);">Categories</h1>

    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary shadow-sm" style="border-radius: 0.5rem;">
            <i class="bi bi-plus-circle me-1"></i> New Category
        </a>
    }
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: var(--salem-bg); color: var(--salem-charcoal);">
                    <tr>
                        <th class="ps-4" style="width: 10%">ID</th>
                        <th style="width: 40%">Category Name</th>
                        <th style="width: 30%">Type</th>
                        @if (isAdmin)
                        {
                            <th style="width: 20%" class="text-center pe-4">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">#@item.CategoryId</td>
                                <td class="fw-bold" style="color: var(--salem-charcoal);">@item.CategoryName</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ParentCategoryName))
                                    {
                                        <span class="badge" style="background-color: var(--salem-sage); color: white;">Sub-category of @item.ParentCategoryName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">Main Category</span>
                                    }
                                </td>
                                @if (isAdmin)
                                {
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm">
                                            <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-outline-secondary">Edit</a>
                                            <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-outline-info" style="color: var(--salem-charcoal); border-color: #6c757d;">Details</a>
                                            <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-outline-danger"
                                               onclick="return confirm('Delete this category?')">Delete</a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 4 : 3)" class="text-center py-5 text-muted">
                                No categories found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>