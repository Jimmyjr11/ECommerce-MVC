@model CategoryVM
@{
    ViewData["Title"] = "Create Category";
    // Prepare the list for the dropdown
    var categoryList = new SelectList(ViewBag.Categories, "CategoryId", "Name");
}

<h1>Create Category</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @* Validation Summary for general errors *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="CategoryName" class="form-label"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParentCategoryId" class="form-label"></label>
                <select asp-for="ParentCategoryId" class="form-select" asp-items="categoryList">
                    <option value="">-- None (Main Category) --</option>
                </select>
                <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save Category</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}