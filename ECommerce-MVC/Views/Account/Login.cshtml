@model LoginVM
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm mt-5 rounded-4 p-3">
            <div class="card-header bg-white border-bottom-0 text-center pt-4">
                <h2 class="mb-0 fw-bold" style="color: var(--salem-charcoal);">Welcome Back</h2>
                <p class="text-muted mt-2">Sign in to your Salem's account</p>
            </div>

            <div class="card-body px-4">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold" style="color: var(--salem-charcoal);"></label>
                        <input asp-for="Email" class="form-control form-control-lg shadow-sm" placeholder="Enter your email" style="border-radius: 0.5rem;" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold" style="color: var(--salem-charcoal);"></label>
                        <input asp-for="Password" class="form-control form-control-lg shadow-sm" placeholder="Enter your password" style="border-radius: 0.5rem;" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted"></label>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm" style="border-radius: 0.5rem;">Sign In</button>
                    </div>
                </form>
            </div>

            <div class="card-footer bg-white border-top-0 text-center pb-4">
                <p class="mb-0 text-muted">
                    New user?
                    <a asp-action="Register" class="fw-bold text-decoration-none" style="color: var(--salem-terracotta);">Register here</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}