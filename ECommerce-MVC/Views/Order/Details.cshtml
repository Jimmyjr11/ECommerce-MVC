@model OrderDetailsVM

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--salem-charcoal);">Order #@Model.OrderHeader.OrderNumber</h2>
            <p class="text-muted">Placed on @Model.OrderHeader.OrderDate.ToString("f")</p>
        </div>
        <div class="text-end">
            <span class="badge fs-6 px-3 py-2" style="background-color: var(--salem-bg); color: var(--salem-charcoal);">
                Status:
                @switch (Model.OrderHeader.Status)
                {
                    case 1:
                        <span>Pending</span>
                        break;
                    case 2:

                        <span>Processing</span>
                        break;
                    case 3:

                        <span>Shipped</span>
                        break;
                    case 4:

                        <span>Delivered</span>
                        break;
                    default:

                        <span>Cancelled</span>
                        break;
                }
            </span>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th class="ps-4 py-3">Product</th>
                                <th class="text-center">Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="pe-4 text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                            {
                                                <img src="@item.Product.ImageUrl" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                            }
                                            <span class="fw-bold">@item.Product.Name</span>
                                        </div>
                                    </td>
                                    <td class="text-center">@item.UnitPrice.ToString("C")</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="pe-4 text-end fw-bold">@((item.UnitPrice * item.Quantity).ToString("C"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end py-4 fw-bold h5 mb-0">Grand Total:</td>
                                <td class="pe-4 text-end py-4 fw-bold h5 mb-0" style="color: var(--salem-terracotta);">@Model.OrderHeader.TotalAmount.ToString("C")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background-color: var(--salem-bg);">
                <h5 class="fw-bold mb-3"><i class="bi bi-geo-alt me-2"></i> Shipping To</h5>
                @if (Model.OrderHeader.ShippingAddress != null)
                {
                    <div class="lh-sm">
                        <p class="fw-bold mb-1">@Model.OrderHeader.User?.FullName</p>
                        <p class="text-muted mb-1">@Model.OrderHeader.ShippingAddress.Street</p>
                        <p class="text-muted mb-0">@Model.OrderHeader.ShippingAddress.City, Egypt</p>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2 small mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Address details not found.
                    </div>
                }
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3">Customer Contact</h5>
                <p class="mb-1"><i class="bi bi-envelope me-2 text-muted"></i> @Model.OrderHeader.User?.Email</p>
                <p class="mb-0"><i class="bi bi-person me-2 text-muted"></i> ID: @Model.OrderHeader.UserId.Substring(0, 8)...</p>
            </div>

            <div class="mt-4 d-grid">
                <a asp-action="@(User.IsInRole("Admin") ? "Manage" : "MyOrders")" class="btn btn-outline-secondary rounded-pill">
                    <i class="bi bi-arrow-left me-2"></i> Back to History
                </a>
            </div>
        </div>
    </div>
</div>