@model IEnumerable<ECommerce_MVC.Models.Model.Order>

@{
    ViewData["Title"] = "Order Management";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: var(--salem-charcoal);">
            <i class="bi bi-shield-lock me-2" style="color: var(--salem-terracotta);"></i> Order Control Center
        </h2>
        <span class="badge rounded-pill px-3 py-2" style="background-color: var(--salem-bg); color: var(--salem-charcoal); border: 1px solid rgba(0,0,0,0.05);">
            Total Orders: @Model.Count()
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="bi bi-inbox text-muted mb-3" style="font-size: 3rem;"></i>
            <h4 class="text-muted">No orders have been placed yet.</h4>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: var(--salem-bg); color: var(--salem-charcoal); border-bottom: 2px solid rgba(0,0,0,0.05);">
                        <tr>
                            <th class="ps-4">Order #</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total Amount</th>
                            <th>Status Update</th>
                            <th class="text-center pe-4">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <code class="fw-bold" style="color: var(--salem-charcoal);">@order.OrderNumber</code>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold">@(order.User?.FullName ?? "Guest User")</span>
                                        <small class="text-muted">@(order.User?.Email ?? "N/A")</small>
                                    </div>
                                </td>
                                <td class="text-muted small">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                <td class="fw-bold" style="color: var(--salem-terracotta);">@order.TotalAmount.ToString("C")</td>
                                <td>
                                    <form asp-action="Manage" method="post" class="d-flex align-items-center">
                                        <input type="hidden" name="orderId" value="@order.OrderId" />

                                        <select name="newStatus" class="form-select form-select-sm me-2 border-0 shadow-sm bg-light" style="width: 130px; border-radius: 0.5rem;">
                                            <option value="1" selected="@(order.Status == 1)">Pending</option>
                                            <option value="2" selected="@(order.Status == 2)">Processing</option>
                                            <option value="3" selected="@(order.Status == 3)">Shipped</option>
                                            <option value="4" selected="@(order.Status == 4)">Delivered</option>
                                            <option value="5" selected="@(order.Status == 5)">Cancelled</option>
                                        </select>

                                        <button type="submit" class="btn btn-sm btn-primary shadow-sm">
                                            Update
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>