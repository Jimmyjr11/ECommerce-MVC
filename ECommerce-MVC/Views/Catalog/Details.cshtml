@model ProductVM

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Shop</a></li>
            <li class="breadcrumb-item"><a href="#">@Model.CategoryName</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm p-4">
        <div class="row">
            <div class="col-md-6 mb-4 mb-md-0 text-center bg-light rounded d-flex align-items-center justify-content-center" style="min-height: 400px;">
                <i class="bi bi-image text-secondary" style="font-size: 8rem;"></i>
            </div>

            <div class="col-md-6 ps-md-5">
                <div class="mb-2">
                    <span class="badge bg-info text-dark">@Model.CategoryName</span>
                </div>

                <h1 class="display-5 fw-bolder mb-3">@Model.Name</h1>
                <p class="text-muted mb-4">SKU: <code>@Model.SKU</code></p>

                <h2 class="text-primary fw-bold mb-4">@Model.Price.ToString("C")</h2>

                <div class="mb-4">
                    @if (Model.StockQuantity > 10)
                    {
                        <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> In Stock (@Model.StockQuantity available)</span>
                    }
                    else if (Model.StockQuantity > 0)
                    {
                        <span class="text-warning"><i class="bi bi-exclamation-circle-fill me-1"></i> Low Stock (Only @Model.StockQuantity left!)</span>
                    }
                    else
                    {
                        <span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i> Out of Stock</span>
                    }
                </div>

                <hr class="my-4" />

                <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                    <input type="number" class="form-control me-2" value="1" min="1" max="@Model.StockQuantity" style="max-width: 100px;" @(Model.StockQuantity == 0 ? "disabled" : "") />

                    <a asp-controller="Cart"
                       asp-action="Add"
                       asp-route-id="@Model.ProductId"
                       class="btn btn-success btn-lg px-4">
                        <i class="bi bi-cart-plus me-2"></i> Add to Cart
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>