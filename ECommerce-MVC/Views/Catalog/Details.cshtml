@model ECommerce_MVC.Models.VIEWMODELS.ProductVM

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none" style="color: var(--salem-charcoal);">Shop</a></li>
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none" style="color: var(--salem-charcoal);">@Model.CategoryName</a></li>
            <li class="breadcrumb-item active fw-bold" aria-current="page" style="color: var(--salem-terracotta);">@Model.Name</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm p-4 rounded-4">
        <div class="row">

            <div class="col-md-6 mb-4 mb-md-0 text-center rounded d-flex align-items-center justify-content-center overflow-hidden" style="min-height: 400px; background-color: var(--salem-bg);">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow-sm" style="max-height: 450px; object-fit: contain;">
                }
                else
                {
                    <i class="bi bi-image text-secondary" style="font-size: 8rem; opacity: 0.5;"></i>
                }
            </div>

            <div class="col-md-6 ps-md-5">
                <div class="mb-2">
                    <span class="badge" style="background-color: var(--salem-sage); color: white;">@Model.CategoryName</span>
                </div>

                <h1 class="display-5 fw-bolder mb-3" style="color: var(--salem-charcoal);">@Model.Name</h1>
                <p class="text-muted mb-4">SKU: <code>@Model.SKU</code></p>

                <h2 class="fw-bold mb-4" style="color: var(--salem-terracotta);">@Model.Price.ToString("C")</h2>

                <div class="mb-4">
                    @if (Model.StockQuantity > 10)
                    {
                        <span style="color: var(--salem-sage); font-weight: bold;"><i class="bi bi-check-circle-fill me-1"></i> In Stock (@Model.StockQuantity available)</span>
                    }
                    else if (Model.StockQuantity > 0)
                    {
                        <span class="text-warning fw-bold"><i class="bi bi-exclamation-circle-fill me-1"></i> Low Stock (Only @Model.StockQuantity left!)</span>
                    }
                    else
                    {
                        <span class="text-danger fw-bold"><i class="bi bi-x-circle-fill me-1"></i> Out of Stock</span>
                    }
                </div>

                <hr class="my-4" style="border-color: rgba(0,0,0,0.1);" />

                <form asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@Model.ProductId" />

                    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                        <input type="number" name="quantity" class="form-control me-2 shadow-sm" value="1" min="1" max="@Model.StockQuantity" style="max-width: 100px; border-color: var(--salem-terracotta);" @(Model.StockQuantity == 0 ? "disabled" : "") />

                        <button type="submit" class="btn btn-primary btn-lg px-4 shadow-sm" @(Model.StockQuantity == 0 ? "disabled" : "")>
                            <i class="bi bi-cart-plus me-2"></i> Add to Cart
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>