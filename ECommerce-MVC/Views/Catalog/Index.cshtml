@model IEnumerable<ECommerce_MVC.Models.Model.Product>

@{
    ViewData["Title"] = "Shop";
}

<div class="container mt-5">
    <h2 class="mb-4 border-bottom pb-2">All Products</h2>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="bg-light text-center py-5 border-bottom">
                            <i class="bi bi-box-seam text-secondary" style="font-size: 4rem;"></i>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-info text-dark">@item.Category?.Name</span>
                            </div>
                            <h5 class="card-title text-truncate" title="@item.Name">@item.Name</h5>
                            <p class="text-muted small mb-3">SKU: @item.SKU</p>

                            <div class="mt-auto">
                                <h4 class="text-primary fw-bold mb-3">@item.Price.ToString("C")</h4>

                                <div class="d-grid gap-2">
                                    <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-outline-primary">
                                        <i class="bi bi-eye"></i> View Details
                                    </a>
                                    <a asp-controller="Cart"
                                       asp-action="Add"
                                       asp-route-id="@item.ProductId"
                                       class="btn btn-success">
                                        <i class="bi bi-cart-plus"></i> Add to Cart
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-emoji-frown fs-1 text-muted"></i>
                <h4 class="text-muted mt-3">No products available right now.</h4>
            </div>
        }
    </div>
</div>