@model ECommerce_MVC.Models.VIEWMODELS.ProductListVM
@using X.PagedList
@using X.PagedList.Mvc.Core

<div class="container mt-4">
    <div class="row">

        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3"><i class="bi bi-search"></i> Search</h5>
                    <form asp-controller="Catalog" asp-action="Index" method="get">
                        @if (Model.CurrentCategoryId.HasValue)
                        {
                            <input type="hidden" name="categoryId" value="@Model.CurrentCategoryId.Value" />
                        }
                        <div class="input-group">
                            <input type="text" name="q" class="form-control" placeholder="Product name..." value="@Model.CurrentSearchQuery">
                            <button class="btn btn-primary" type="submit">Go</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="bi bi-tags"></i> Categories
                </div>
                <ul class="list-group list-group-flush">
                    <a asp-action="Index" asp-route-q="@Model.CurrentSearchQuery"
                       class="list-group-item list-group-item-action @(!Model.CurrentCategoryId.HasValue ? "active fw-bold" : "")">
                        All Categories
                    </a>

                    @foreach (var cat in Model.Categories)
                    {
                        <a asp-action="Index"
                           asp-route-categoryId="@cat.CategoryId"
                           asp-route-q="@Model.CurrentSearchQuery"
                           class="list-group-item list-group-item-action @(Model.CurrentCategoryId == cat.CategoryId ? "active fw-bold" : "")">
                            @cat.Name
                        </a>
                    }
                </ul>
            </div>
        </div>

        <div class="col-md-9">
            <h2 class="mb-4">Our Products</h2>

            @if (!Model.Products.Any())
            {
                <div class="alert alert-warning text-center">
                    <i class="bi bi-emoji-frown fs-4"></i><br />
                    No products found matching your search or filter.
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @foreach (var item in Model.Products)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0">
                                <img src="https://via.placeholder.com/300x200?text=@item.Name" class="card-img-top" alt="@item.Name">

                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title text-truncate" title="@item.Name">@item.Name</h5>
                                    <h4 class="text-primary fw-bold mb-3">@item.Price.ToString("C")</h4>

                                    <div class="mt-auto d-flex justify-content-between">
                                        <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-outline-secondary btn-sm">
                                            Details
                                        </a>
                                        <a asp-controller="Cart" asp-action="Add" asp-route-productId="@item.ProductId" class="btn btn-primary btn-sm">
                                            <i class="bi bi-cart-plus"></i> Add
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-center mt-5">
                    @Html.PagedListPager((IPagedList)Model.Products, page => Url.Action("Index", new
                    {
                        page = page,
                                categoryId = Model.CurrentCategoryId,
                                q = Model.CurrentSearchQuery
                                }),
                                new PagedListRenderOptions
                                {
                                    LiElementClasses = new string[] { "page-item" },
                                    PageClasses = new string[] { "page-link" },
                                    ActiveLiElementClass = "active",
                                    DisplayItemSliceAndTotal = false
                                })
            </div>
                        }
        </div>
    </div>
</div>