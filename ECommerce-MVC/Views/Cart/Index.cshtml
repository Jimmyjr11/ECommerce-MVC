@model Cart

<div class="container mt-5">
    <h2 class="mb-4"><i class="bi bi-cart3"></i> Your Shopping Cart</h2>

    @if (Model.CartItems.Any())
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle bg-white">
                <thead class="table-dark">
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CartItems)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-dark">@item.ProductName</span>
                            </td>
                            <td>@item.Price.ToString("C")</td>
                            <td style="width: 160px;">
                                <div class="d-flex align-items-center border rounded-pill bg-light p-1">
                                    <a asp-action="Decrease" asp-route-id="@item.ProductId"
                                       class="btn btn-sm btn-white rounded-circle shadow-sm border-0"
                                       style="width: 30px; height: 30px;">
                                        <i class="bi bi-dash"></i>
                                    </a>

                                    <span class="flex-grow-1 text-center fw-bold">@item.Quantity</span>

                                    <a asp-action="Add" asp-route-id="@item.ProductId"
                                       class="btn btn-sm btn-white rounded-circle shadow-sm border-0"
                                       style="width: 30px; height: 30px;">
                                        <i class="bi bi-plus"></i>
                                    </a>
                                </div>
                            </td>
                            <td class="fw-bold">@item.Total.ToString("C")</td>
                            <td class="text-end">
                                <a asp-action="Remove" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <td colspan="3" class="text-end fw-bold fs-5">Grand Total:</td>
                        <td colspan="2" class="text-primary fw-bold fs-5">@Model.GrandTotal.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between mt-4">

            <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-arrow-left"></i> Continue Shopping
            </a>
            <a asp-controller="Order" asp-action="Checkout" class="btn btn-success btn-lg px-5">
                Proceed to Checkout <i class="bi bi-credit-card ms-2"></i>
            </a>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x text-muted" style="font-size: 5rem;"></i>
            <h3 class="mt-3 text-muted">Your cart is empty!</h3>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary mt-3">Start Shopping</a>
        </div>
    }
</div>