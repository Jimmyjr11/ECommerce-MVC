@model Cart

<div class="container mt-5 mb-5">
    <h2 class="mb-4 fw-bold" style="color: var(--salem-charcoal);">
        <i class="bi bi-bag-heart me-2" style="color: var(--salem-terracotta);"></i> Your Shopping Bag
    </h2>

    @if (Model.CartItems.Any())
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: var(--salem-bg); color: var(--salem-charcoal);">
                                <tr>
                                    <th class="ps-4">Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Subtotal</th>
                                    <th class="pe-4"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CartItems)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-bold d-block" style="color: var(--salem-charcoal);">@item.ProductName</span>
                                        </td>
                                        <td>@item.Price.ToString("C")</td>
                                        <td style="width: 140px;">
                                            <div class="d-flex align-items-center border rounded-pill p-1 bg-light">
                                                <a asp-action="Decrease" asp-route-id="@item.ProductId"
                                                   class="btn btn-sm btn-light rounded-circle border-0 shadow-sm" style="width: 28px; height: 28px;">
                                                    <i class="bi bi-dash"></i>
                                                </a>
                                                <span class="flex-grow-1 text-center fw-bold small">@item.Quantity</span>
                                                <a asp-action="Add" asp-route-id="@item.ProductId"
                                                   class="btn btn-sm btn-light rounded-circle border-0 shadow-sm" style="width: 28px; height: 28px;">
                                                    <i class="bi bi-plus"></i>
                                                </a>
                                            </div>
                                        </td>
                                        <td class="fw-bold" style="color: var(--salem-charcoal);">@item.Total.ToString("C")</td>
                                        <td class="text-end pe-4">
                                            <a asp-action="Remove" asp-route-id="@item.ProductId" class="text-danger opacity-75 hover-opacity-100">
                                                <i class="bi bi-trash3 fs-5"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-controller="Catalog" asp-action="Index" class="btn text-decoration-none p-0" style="color: var(--salem-charcoal);">
                        <i class="bi bi-arrow-left me-2"></i> Keep Browsing
                    </a>
                    <a asp-action="Clear" class="btn btn-sm btn-outline-danger border-0">Clear Bag</a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4" style="background-color: var(--salem-bg);">
                    <h5 class="fw-bold mb-4">Order Summary</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Items:</span>
                        <span>@Model.CartItems.Sum(x => x.Quantity)</span>
                    </div>
                    <hr class="opacity-10">
                    <div class="d-flex justify-content-between mb-4">
                        <span class="h5 fw-bold">Total:</span>
                        <span class="h5 fw-bold" style="color: var(--salem-terracotta);">@Model.GrandTotal.ToString("C")</span>
                    </div>

                    <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary btn-lg w-100 py-3 shadow-sm rounded-3">
                        Proceed to Checkout <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                    <div class="text-center mt-3">
                        <small class="text-muted"><i class="bi bi-shield-check me-1"></i> Secure Checkout</small>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="bi bi-cart-x opacity-25" style="font-size: 6rem; color: var(--salem-charcoal);"></i>
            </div>
            <h3 class="fw-bold" style="color: var(--salem-charcoal);">Your bag is currently empty</h3>
            <p class="text-muted mb-4">Looks like you haven't added any premium electronics yet.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary px-5 py-3 rounded-pill shadow">
                Explore Catalog
            </a>
        </div>
    }
</div>