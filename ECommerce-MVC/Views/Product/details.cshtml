@model ProductVM

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white">
            <h3 class="card-title mb-0"><i class="bi bi-info-circle me-2"></i>Product Information</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Product ID</dt>
                <dd class="col-sm-9"><span class="badge bg-secondary">@Model.ProductId</span></dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
                <dd class="col-sm-9 fw-bold">@Model.Name</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SKU)</dt>
                <dd class="col-sm-9"><code>@Model.SKU</code></dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CategoryName)</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary">@Model.CategoryName</span>
                </dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Price)</dt>
                <dd class="col-sm-9 text-success fw-bold">@Model.Price.ToString("C")</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StockQuantity)</dt>
                <dd class="col-sm-9">
                    @if (Model.StockQuantity <= 0)
                    {
                        <span class="text-danger">Out of Stock</span>
                    }
                    else
                    {
                        @Model.StockQuantity
                    }
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="text-success"><i class="bi bi-check-circle-fill"></i> Active</span>
                    }
                    else
                    {
                        <span class="text-muted"><i class="bi bi-x-circle-fill"></i> Inactive</span>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-light">
            <div class="btn-group">
                <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>