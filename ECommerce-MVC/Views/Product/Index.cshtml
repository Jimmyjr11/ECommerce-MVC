@model IEnumerable<ProductVM>

@{
    ViewData["Title"] = "Product Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6">Products</h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle"></i> Add New Product
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>SKU</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted small">@item.SKU</td>
                                <td class="fw-bold">@item.Name</td>
                                <td>
                                    <span class="badge bg-info text-dark">@item.CategoryName</span>
                                </td>
                                <td>@item.Price.ToString("C")</td>
                                <td>
                                    @if (item.StockQuantity <= 0)
                                    {
                                        <span class="text-danger fw-bold">Out of Stock</span>
                                    }
                                    else if (item.StockQuantity < 10)
                                    {
                                        <span class="text-warning fw-bold">Low: @item.StockQuantity</span>
                                    }
                                    else
                                    {
                                        <span class="text-success">@item.StockQuantity</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-outline-secondary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-outline-info">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-outline-danger"
                                           onclick="return confirm('Delete @item.Name permanently?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <p>No products available yet.</p>
                                <a asp-action="Create" class="btn btn-sm btn-outline-primary">Add your first product</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>