@model IEnumerable<ECommerce_MVC.Models.VIEWMODELS.ProductVM>

@{
    ViewData["Title"] = "Product Management";

    // We check their VIP pass once at the top to keep the code clean!
    bool isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h1 class="display-6 fw-bold" style="color: var(--salem-charcoal);">Products</h1>

    @* HIDDEN FROM CUSTOMERS: Only Admins can add new products *@
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary shadow-sm" style="border-radius: 0.5rem;">
            <i class="bi bi-plus-circle me-1"></i> Add New Product
        </a>
    }
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: var(--salem-bg); color: var(--salem-charcoal); border-bottom: 2px solid rgba(0,0,0,0.05);">
                    <tr>
                        <th class="ps-4">SKU</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>

                        @if (isAdmin)
                        {
                            <th class="text-center pe-4">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted small ps-4"><code>@item.SKU</code></td>
                                <td class="fw-bold" style="color: var(--salem-charcoal);">@item.Name</td>
                                <td>
                                    <span class="badge" style="background-color: var(--salem-sage); color: white;">@item.CategoryName</span>
                                </td>
                                <td class="fw-bold" style="color: var(--salem-terracotta);">@item.Price.ToString("C")</td>
                                <td>
                                    @if (item.StockQuantity <= 0)
                                    {
                                        <span class="text-danger fw-bold">Out of Stock</span>
                                    }
                                    else if (item.StockQuantity < 10)
                                    {
                                        <span class="text-warning fw-bold">Low: @item.StockQuantity</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--salem-sage); font-weight: 500;">@item.StockQuantity</span>
                                    }
                                </td>

                                @* HIDDEN FROM CUSTOMERS: The Edit/Delete buttons *@
                                @if (isAdmin)
                                {
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm">
                                            <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-outline-secondary">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-outline-info" style="color: var(--salem-charcoal); border-color: #6c757d;">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-outline-danger"
                                               onclick="return confirm('Delete @item.Name permanently?')">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 6 : 5)" class="text-center py-5 text-muted">
                                <p class="mb-2">No products available yet.</p>
                                @if (isAdmin)
                                {
                                    <a asp-action="Create" class="btn btn-sm btn-primary">Add your first product</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>